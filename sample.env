# Configuración local del backend. No incluir credenciales ni datos reales.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Completar en .env con la URL de una base PostgreSQL local.
DATABASE_URL=

# Generar con node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))".
# Se exige al activar autenticación; no reutilizar esta muestra como clave.
JWT_SECRET=
